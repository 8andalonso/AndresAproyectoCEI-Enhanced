        <!-- SECCIÓN 6 -->
        <h1>6. GUÍA DE USO</h1>

        <h2>Instalación</h2>
        <div class="code-block">
pip install -r requirements.txt
        </div>

        <h2>Uso Básico</h2>
        <div class="code-block">
from ColabAndresAlonso_MEJORADO import DiseaseAnalyzer

# Cargar datos
analyzer = DiseaseAnalyzer('annual_deaths_by_causes.csv')

# Top 15 enfermedades
top_diseases = analyzer.get_top_diseases(15)
print(top_diseases)

# Top 20 países
top_countries = analyzer.get_top_countries(20)
print(top_countries)
        </div>

        <h2>Análisis de Tendencias</h2>
        <div class="code-block">
result = analyzer.calculate_trends('Malaria')

if result:
    print(f"Enfermedad: {result['enfermedad']}")
    print(f"Tendencia: {result['tendencia']}")
    print(f"Cambio/año: {result['tasa_cambio']:.0f}")
    print(f"R²: {result['r_cuadrado']:.3f}")
        </div>

        <h2>Análisis Avanzados</h2>
        <div class="code-block">
from analisis_avanzado import AdvancedAnalyzer

adv = AdvancedAnalyzer(analyzer.df_clean)

# Clustering de países
resultado, kmeans = adv.clustering_paises(n_clusters=5)

# Análisis de desigualdad
desigualdad = adv.analisis_desigualdad('Malaria')

# Outliers
outliers = adv.identificar_outliers('Tuberculosis')
        </div>

        <h2>Exportar Resultados</h2>
        <div class="code-block">
analyzer.export_results('resultados')
        </div>

